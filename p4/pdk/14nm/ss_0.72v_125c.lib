/* 14nm FinFET Standard Cell Liberty Timing Model: ss_0.72v_125c.lib
 * Slow-Slow Worst-Case Corner: VDD = 0.72V (-10%), T = 125C
 * Target Frequency: 1.0 GHz (T_clk = 1.000 ns, 1000 ps)
 */

library (sonic_14nm_ss) {
  technology (cmos);
  delay_model : table_lookup;
  time_unit : "1ps";
  voltage_unit : "1V";
  current_unit : "1mA";
  nom_process : 1.0;
  nom_temperature : 125.0;
  nom_voltage : 0.72;

  /* Gate delays scaled by 1.34x for SS corner */
  cell (DFF_X1) {
    area : 1.84;
    pin (CLK) { direction : input; clock : true; }
    pin (D)   { direction : input; }
    pin (Q)   {
      direction : output;
      timing () {
        related_pin : "CLK";
        timing_type : rising_edge;
        cell_rise (scalar) { values ("37.5"); }
        cell_fall (scalar) { values ("37.5"); }
      }
    }
  }

  cell (NAND2_X1) {
    area : 0.92;
    pin (A) { direction : input; }
    pin (B) { direction : input; }
    pin (Y) {
      direction : output;
      function : "!(A & B)";
      timing () {
        cell_rise (scalar) { values ("15.0"); }
        cell_fall (scalar) { values ("14.5"); }
      }
    }
  }

  cell (FA_X1) {
    area : 3.68;
    pin (A) { direction : input; }
    pin (B) { direction : input; }
    pin (CI){ direction : input; }
    pin (S) {
      direction : output;
      timing () {
        cell_rise (scalar) { values ("42.2"); }
        cell_fall (scalar) { values ("41.3"); }
      }
    }
  }
}
